# Copy this file to .env and fill in both values. Both keys are required.
#
# Google Gemini — the LLM used by the planner, evaluator, and reporter.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Jina — used for BOTH web search (s.jina.ai, key required) and the scrape
# fallback (r.jina.ai). https://jina.ai/api-dashboard/
JINA_API_KEY=

# On Streamlit Community Cloud, set the same names under Settings -> Secrets
# instead of using this file.
